# Replace this entire placeholder with your private Neon PostgreSQL connection URL.
# Keep .env local. This example deliberately has no username or password.
# The loader enforces certificate and hostname verification, even for require URLs.
# A portable certifi CA bundle is used unless sslrootcert/PGSSLROOTCERT is explicit.
DATABASE_URL=postgresql://YOUR_HOST/neondb?sslmode=verify-full
