Project FoodLens {
  database_type: 'PostgreSQL'
}

Table brands {
  brand_id "text" [not null, pk]
  brand_name "text" [not null, unique]
  checks {
    `brand_id <> ''` [name: 'brands_check_01']
    `brand_name <> ''` [name: 'brands_check_02']
  }
}

Table categories {
  category_id "text" [not null, pk]
  category_name "text" [not null, unique]
  checks {
    `category_id <> ''` [name: 'categories_check_01']
    `category_name <> ''` [name: 'categories_check_02']
  }
}

Table products {
  barcode "text" [not null, pk]
  product_name "text" [null]
  original_product_name "text" [null]
  brand_id "text" [null]
  original_brands "text" [null]
  nutriscore_grade "text" [null]
  nutriscore_status "text" [not null]
  nova_group "smallint" [null]
  primary_category_id "text" [not null]
  extraction_id "text" [not null]
  source_page "integer" [not null]
  source_record_index "integer" [not null]
  extracted_at_utc "timestamptz" [null]
  record_origin "text" [not null]
  source_relative_path "text" [not null]
  source_response_sha256 "text" [not null]
  checks {
    `barcode ~ '^[0-9]{8,14}$'` [name: 'products_check_01']
    `nutriscore_grade IN ('a', 'b', 'c', 'd', 'e')` [name: 'products_check_02']
    `nutriscore_status IN ('reported', 'unknown', 'not_applicable', 'missing', 'invalid')` [name: 'products_check_03']
    `(nutriscore_status = 'reported') = (nutriscore_grade IS NOT NULL)` [name: 'products_check_04']
    `nova_group BETWEEN 1 AND 4` [name: 'products_check_05']
    `source_page >= 1` [name: 'products_check_06']
    `source_record_index >= 0` [name: 'products_check_07']
    `record_origin IN ('api', 'legacy_import')` [name: 'products_check_08']
  }
  Note: 'Nutrition and primary-membership FKs are DEFERRABLE INITIALLY DEFERRED in SQL. Insert related rows in one transaction.'
}

Table product_categories {
  barcode "text" [not null]
  category_id "text" [not null]
  indexes {
    (barcode, category_id) [pk]
  }
}

